{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schema/finding.schema.json",
  "title": "Finding",
  "description": "One review finding emitted by a review layer (the generic pass or a domain agent).",
  "type": "object",
  "required": ["severity", "title", "file", "line"],
  "additionalProperties": false,
  "properties": {
    "severity": {
      "type": "string",
      "enum": ["critical", "important", "suggestion"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "line": {
      "type": "integer",
      "minimum": 0
    },
    "description": {
      "type": "string"
    },
    "fix": {
      "type": "string"
    },
    "rule_id": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "snippet": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "merged_count": {
      "type": "integer",
      "minimum": 1
    }
  }
}
